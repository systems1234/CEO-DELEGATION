# Python service configuration

# Common
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
CEO_WA_NUMBER=919999999999
WA_PROVIDER=meta
SCRIPT_TIMEZONE=Asia/Kolkata
HTTP_TIMEOUT_SECONDS=20

# Dashboard SSO (Google Workspace)
DASHBOARD_AUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# Restrict who can sign in: your Workspace domain, and/or a comma-separated allowlist
ALLOWED_GOOGLE_DOMAIN=gempundit.com
ALLOWED_GOOGLE_EMAILS=
SESSION_SECRET=generate-a-long-random-string-here
# Full public URL of the deployment (used to build the OAuth redirect_uri), e.g. https://ceo-delegation.vercel.app
PUBLIC_BASE_URL=

# BigQuery
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=ceod

# Choose one of these credential options (needs BigQuery Data Editor + Job User roles):
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}

# Meta WhatsApp Cloud API
META_API_BASE=https://graph.facebook.com
META_API_VERSION=v19.0
WA_ACCESS_TOKEN=EAAG_your_meta_access_token
WA_PHONE_NUMBER_ID=123456789012345
WA_VERIFY_TOKEN=your_webhook_verify_token

# Green API
GREEN_API_URL=https://7105.api.greenapi.com
GREEN_API_INSTANCE_ID=7105123456
GREEN_API_TOKEN=your_green_api_token
# Optional: restrict inbound group messages to one group (leave blank to allow all groups)
GREEN_API_ALLOWED_GROUP_ID=919058467188-1610650820@g.us

# Daily follow-up cron (triggered by GCP Cloud Scheduler hitting POST /api/cron/daily-followup
# with header "X-Cron-Secret: <this value>")
CRON_SECRET=generate-another-long-random-string-here
